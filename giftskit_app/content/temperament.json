      "high_en": "Structured", "high_ko": "계획적인",
      "items": [
        {"id": "structure.1", "key": 1, "ipip": "Am always prepared.", "en": "I'm always prepared.", "ko": "늘 준비되어 있다."},
        {"id": "structure.2", "key": 1, "ipip": "Pay attention to details.", "en": "I pay attention to details.", "ko": "세부 사항에 신경 쓴다."},
        {"id": "structure.3", "key": 1, "ipip": "Get chores done right away.", "en": "I get chores done right away.", "ko": "할 일은 바로 끝낸다."},
        {"id": "structure.4", "key": 1, "ipip": "Follow a schedule.", "en": "I follow a schedule.", "ko": "일정표대로 움직인다."},
        {"id": "structure.5", "key": -1, "ipip": "Leave my belongings around.", "en": "I leave my things lying around.", "ko": "물건을 여기저기 늘어놓는다."},
        {"id": "structure.6", "key": -1, "ipip": "Make a mess of things.", "en": "I make a mess of things.", "ko": "일을 엉망으로 만들곤 한다."},
        {"id": "structure.7", "key": -1, "ipip": "Often forget to put things back in their proper place.", "en": "I often forget to put things back where they belong.", "ko": "물건을 제자리에 두는 걸 자주 잊는다."},
        {"id": "structure.8", "key": -1, "ipip": "Shirk my duties.", "en": "I put off my duties.", "ko": "해야 할 일을 미룬다."}
      ]
    },
    {
