      "high_en": "Warm", "high_ko": "다정한",
      "items": [
        {"id": "warmth.1", "key": 1, "ipip": "Sympathize with others' feelings.", "en": "I sympathize with others' feelings.", "ko": "다른 사람의 감정에 공감한다."},
        {"id": "warmth.2", "key": 1, "ipip": "Have a soft heart.", "en": "I have a soft heart.", "ko": "마음이 여리다."},
        {"id": "warmth.3", "key": 1, "ipip": "Take time out for others.", "en": "I take time out for others.", "ko": "다른 사람을 위해 시간을 낸다."},
        {"id": "warmth.4", "key": 1, "ipip": "Make people feel at ease.", "en": "I make people feel at ease.", "ko": "사람들을 편안하게 해 준다."},
        {"id": "warmth.5", "key": -1, "ipip": "Feel little concern for others.", "en": "I feel little concern for others.", "ko": "다른 사람에게 별로 마음을 쓰지 않는다."},
        {"id": "warmth.6", "key": -1, "ipip": "Am not interested in other people's problems.", "en": "I'm not very interested in other people's problems.", "ko": "남의 문제에는 별 관심이 없다."},
        {"id": "warmth.7", "key": -1, "ipip": "Am not really interested in others.", "en": "I'm not really interested in others.", "ko": "다른 사람에게 그다지 관심이 없다."},
        {"id": "warmth.8", "key": -1, "ipip": "Insult people.", "en": "I can be harsh with people.", "ko": "사람들에게 모질게 말할 때가 있다."}
      ]
    },
    {
      "id": "structure", "factor": "Conscientiousness",
