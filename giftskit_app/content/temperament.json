      "items": [
        {"id": "outgoing.1", "key": 1, "ipip": "Feel comfortable around people.", "en": "I feel comfortable around people.", "ko": "사람들 사이에 있으면 편하다."},
        {"id": "outgoing.2", "key": 1, "ipip": "Start conversations.", "en": "I start conversations.", "ko": "내가 먼저 말을 건다."},
        {"id": "outgoing.3", "key": 1, "ipip": "Talk to a lot of different people at parties.", "en": "I talk to a lot of different people at gatherings.", "ko": "모임에서 여러 사람과 두루 이야기한다."},
        {"id": "outgoing.4", "key": 1, "ipip": "Don't mind being the center of attention.", "en": "I don't mind being the center of attention.", "ko": "주목받는 자리도 괜찮다."},
        {"id": "outgoing.5", "key": -1, "ipip": "Don't talk a lot.", "en": "I don't talk a lot.", "ko": "말을 많이 하지 않는다."},
        {"id": "outgoing.6", "key": -1, "ipip": "Keep in the background.", "en": "I keep in the background.", "ko": "뒤쪽에 있는 편이다."},
        {"id": "outgoing.7", "key": -1, "ipip": "Am quiet around strangers.", "en": "I'm quiet around people I don't know.", "ko": "모르는 사람들 앞에서는 조용하다."},
        {"id": "outgoing.8", "key": -1, "ipip": "Don't like to draw attention to myself.", "en": "I don't like to draw attention to myself.", "ko": "나에게 시선이 쏠리는 게 싫다."}
      ]
    },
    {
