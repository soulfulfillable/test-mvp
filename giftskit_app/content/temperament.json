      "high_en": "Imaginative", "high_ko": "상상하는",
      "items": [
        {"id": "imagination.1", "key": 1, "ipip": "Have a vivid imagination.", "en": "I have a vivid imagination.", "ko": "상상력이 풍부하다."},
        {"id": "imagination.2", "key": 1, "ipip": "Am full of ideas.", "en": "I'm full of ideas.", "ko": "아이디어가 넘친다."},
        {"id": "imagination.3", "key": 1, "ipip": "Have excellent ideas.", "en": "I come up with excellent ideas.", "ko": "좋은 아이디어를 잘 낸다."},
        {"id": "imagination.4", "key": 1, "ipip": "Am quick to understand things.", "en": "I'm quick to understand things.", "ko": "이해가 빠르다."},
        {"id": "imagination.5", "key": 1, "ipip": "Spend time reflecting on things.", "en": "I spend time reflecting on things.", "ko": "곰곰이 생각하는 데 시간을 쓴다."},
        {"id": "imagination.6", "key": -1, "ipip": "Am not interested in abstract ideas.", "en": "I'm not interested in abstract ideas.", "ko": "추상적인 생각에는 관심이 없다."},
        {"id": "imagination.7", "key": -1, "ipip": "Do not have a good imagination.", "en": "I don't have a good imagination.", "ko": "상상력이 좋은 편이 아니다."},
        {"id": "imagination.8", "key": -1, "ipip": "Have difficulty understanding abstract ideas.", "en": "I have a hard time with abstract ideas.", "ko": "추상적인 개념은 어렵게 느껴진다."}
      ]
