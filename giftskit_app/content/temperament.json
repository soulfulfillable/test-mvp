      "high_en": "Calm", "high_ko": "잔잔한",
      "items": [
        {"id": "calm.1", "key": 1, "ipip": "Am relaxed most of the time.", "en": "I'm relaxed most of the time.", "ko": "대부분의 시간에 마음이 느긋하다."},
        {"id": "calm.2", "key": 1, "ipip": "Seldom feel blue.", "en": "I seldom feel down.", "ko": "울적할 때가 드물다."},
        {"id": "calm.3", "key": -1, "ipip": "Get stressed out easily.", "en": "I get stressed out easily.", "ko": "쉽게 스트레스를 받는다."},
        {"id": "calm.4", "key": -1, "ipip": "Worry about things.", "en": "I worry about things.", "ko": "이것저것 걱정한다."},
        {"id": "calm.5", "key": -1, "ipip": "Get upset easily.", "en": "I get upset easily.", "ko": "쉽게 속상해한다."},
        {"id": "calm.6", "key": -1, "ipip": "Have frequent mood swings.", "en": "My mood changes often.", "ko": "기분이 자주 바뀐다."},
        {"id": "calm.7", "key": -1, "ipip": "Get irritated easily.", "en": "I get irritated easily.", "ko": "쉽게 짜증이 난다."},
        {"id": "calm.8", "key": -1, "ipip": "Often feel blue.", "en": "I often feel down.", "ko": "자주 울적하다."}
